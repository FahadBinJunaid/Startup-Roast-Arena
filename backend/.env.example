# Copy this file to ".env" and replace the placeholder values with real ones.
# The .env file is ignored by git and must never be committed.

PORT=5000

# MongoDB Atlas connection string (placeholder - put your real one in .env)
MONGO_URI=your_mongodb_atlas_connection_string

# A long random string used to sign JWT tokens
JWT_SECRET=your_long_random_secret

# Google Gemini API key (needed from Phase 4 onward)
GEMINI_API_KEY=your_gemini_api_key

# Optional: override the Gemini model. Defaults to gemini-3.5-flash.
GEMINI_MODEL=gemini-3.5-flash

# CORS: the frontend origin(s) allowed to call this API.
# You can list several origins separated by commas.
# Trailing slashes are ignored, so both of these work:
#   CLIENT_URL=https://my-app.vercel.app
#   CLIENT_URL=https://my-app.vercel.app,https://my-app-git-main.vercel.app
# Leave it empty for local development (then every origin is allowed).
CLIENT_URL=

NODE_ENV=development
