# ==========================================================
# backend/.gitignore
# ==========================================================

# ---------- Dependencies ----------
node_modules/

# ---------- Environment secrets - NEVER commit these ----------
.env
.env.local
.env.*
!.env.example

# ---------- Build output ----------
dist/
build/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*

# ---------- Coverage / test reports ----------
coverage/
.nyc_output/

# ---------- Temporary files ----------
tmp/
temp/
*.tmp
*.temp
.cache/

# ---------- Vercel local config / cache (if this folder is ever deployed) ----------
.vercel/

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- OS-generated files ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
