# ==========================================================
# Startup Roast Arena - root .gitignore
# One shared ignore list for the whole repository.
# The backend/ and frontend/ folders also have their own
# .gitignore files with extra rules for their tooling.
# ==========================================================

# ---------- Dependencies ----------
# Ignore every node_modules folder (backend + frontend).
node_modules/

# ---------- Environment / secret files ----------
# Ignore real env files, but ALWAYS keep the .env.example templates.
.env
.env.local
.env.*
!.env.example

# ---------- Build output ----------
dist/
dist-ssr/
build/
out/

# ---------- Coverage / test reports ----------
coverage/
*.lcov
.nyc_output/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Temporary files ----------
tmp/
temp/
*.tmp
*.temp
.cache/

# ---------- Vercel local config / cache ----------
.vercel/

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- OS-generated files ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
