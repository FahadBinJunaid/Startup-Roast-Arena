# ==========================================================
# frontend/.gitignore
# ==========================================================

# ---------- Logs ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Dependencies ----------
node_modules

# ---------- Build output ----------
dist
dist-ssr
build

# ---------- Coverage / test reports ----------
coverage
*.lcov

# ---------- Environment files (never commit real secrets) ----------
.env
.env.*
!.env.example
*.local

# ---------- Vercel local configuration / cache ----------
.vercel

# ---------- Temporary files ----------
tmp
temp
*.tmp

# ---------- Editor directories and files ----------
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
